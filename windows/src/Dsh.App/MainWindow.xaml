<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dsh.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Dsh.App.Views"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The window carries no bindings of its own: compiled bindings need a
         FrameworkElement to root them, and a WinUI Window is not one. -->
    <views:ShellView x:Name="Shell" />

</Window>
