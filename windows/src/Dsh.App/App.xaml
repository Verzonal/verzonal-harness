<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Dsh.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Dsh.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:TextToVisibilityConverter x:Key="TextToVisibility" />
            <local:PercentConverter x:Key="Percent" />

            <x:Double x:Key="ConversationMaxWidth">820</x:Double>

            <!-- One place decides what code looks like, in cards and in messages alike. -->
            <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="MetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
