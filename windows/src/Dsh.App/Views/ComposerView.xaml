<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Dsh.App.Views.ComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Dsh.App.Core"
    xmlns:session="using:Dsh.Session"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="24,8,24,16" MaxWidth="{StaticResource ConversationMaxWidth}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The checklist, hidden entirely while there is nothing on it. -->
        <Expander
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind Session.Conversation.HasTodos, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock
                    Text="{x:Bind Session.Conversation.TodoSummary, Mode=OneWay}"
                    Style="{StaticResource MetaTextStyle}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{x:Bind Session.Conversation.Todos, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="session:TodoItem">
                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Margin="0,2,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Messages waiting their turn, each removable before it is ever sent. -->
        <ItemsControl
            Grid.Row="1"
            x:Name="QueueDock"
            ItemsSource="{x:Bind Queued, Mode=OneWay}"
            Visibility="{x:Bind HasQueue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:QueuedMessage">
                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,4"
                        Padding="10,6,6,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Preview}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                Grid.Column="1"
                                Click="OnRemoveQueued"
                                Tag="{x:Bind Id}"
                                Padding="6,2,6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Remove">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The approval takeover: it replaces the input rather than floating over it, so
             it cannot be missed or dismissed by reflex. -->
        <InfoBar
            Grid.Row="2"
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="Waiting for you"
            Message="{x:Bind ApprovalMessage, Mode=OneWay}"
            Visibility="{x:Bind Approval.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,12">
                    <Button Content="Reject" Click="OnReject" />
                    <Button Content="Allow once" Style="{StaticResource AccentButtonStyle}" Click="OnAllowOnce" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <Grid
            Grid.Row="2"
            Visibility="{x:Bind Approval.IsWaiting, Mode=OneWay, Converter={StaticResource BoolToCollapsed}}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                x:Name="Draft"
                Text="{x:Bind Session.Composer.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="{x:Bind Session.Composer.Placeholder, Mode=OneWay}"
                IsEnabled="{x:Bind Session.Composer.IsEnabled, Mode=OneWay}"
                KeyDown="OnDraftKeyDown"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="72"
                MaxHeight="240"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                <Button
                    Click="OnStop"
                    Visibility="{x:Bind Session.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="Stop this turn">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
                <Button
                    Click="OnSend"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind Session.Composer.IsEnabled, Mode=OneWay}"
                    ToolTipService.ToolTip="Send">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The status strip: route, permission preset, and how full the context is. -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{x:Bind Session.Conversation.Route, Mode=OneWay}"
                Style="{StaticResource MetaTextStyle}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="1"
                Click="OnCyclePreset"
                Padding="8,2,8,2"
                Background="Transparent"
                BorderThickness="1"
                ToolTipService.ToolTip="Change what tools are allowed to do">
                <TextBlock Text="{x:Bind Preset, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
            </Button>

            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="{x:Bind Session.Conversation.HasContextPressure, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar
                    Width="90"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind Session.Conversation.ContextPercent, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind Session.Conversation.ContextPressure, Mode=OneWay, Converter={StaticResource Percent}}"
                    Style="{StaticResource MetaTextStyle}" />
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>
